programa
{
	
	funcao inicio()
	{
		inteiro dia_aniversario

		
		escreva("\n--------SEJA BEM-VINDO! LEIA SUA MENSAGEM DE ANIVERSÁRIO!--------\n")
		escreva("\nMensagem para você!\n")

		escreva("\nInforme o dia do seu aniversário(1 a 31) :\n")
		leia(dia_aniversario)

		escreva("\nSua mensagem é:\n")
		
		escolha(dia_aniversario)
		{
		  caso 1:
		  	
			escreva("\nA vida trará coisas boas se você tiver paciência.\n")
			escreva("*****************************************************")
			pare

		  caso 2:
		  
			escreva("\nDemonstre amor e alegria em todas as oportunidades.\n")
			escreva("********************************************************")
			pare

		  caso 3:
                escreva("\nNão compense na ira o que lhe falta na razão.\n")
                escreva("***************************************************")
                pare

            caso 4:
                escreva("\nDefeitos e virtudes são apenas dois lados da mesma moeda.\n")
                escreva("**************************************************************")
                pare

            caso 5:
                escreva("\nA maior de todas as torres começa no solo.\n")
                escreva("***********************************************")
                pare

            caso 6:
                escreva("\nAcredite em você mesmo e o universo conspirará a seu favor.\n")
                escreva("****************************************************************")
                pare

            caso 7:
                escreva("\nSeja a mudança que você deseja ver no mundo.\n")
                escreva("*************************************************")
                pare

            caso 8:
                escreva("\nO sucesso não é acidental, é resultado de esforço e dedicação.\n")
                escreva("*******************************************************************")
                pare

            caso 9:
                escreva("\nAprenda com o passado, viva o presente e sonhe com o futuro.\n")
                escreva("*******************************************************************")
                pare

            caso 10:
                escreva("\nSua criatividade é ilimitada, explore novos horizontes.\n")
                escreva("*************************************************************")
                pare

            caso 11:
                escreva("\nA jornada de mil quilômetros começa com um único passo.\n")
                escreva("*************************************************************")
                pare

            caso 12:
                escreva("\nA sorte favorece a mente preparada.\n")
                escreva("*****************************************")
                pare

            caso 13:
                escreva("\nSeja corajoso, mesmo quando estiver com medo.\n")
                escreva("***************************************************")
                pare

            caso 14:
                escreva("\nA amizade é o maior tesouro da vida.\n")
                escreva("******************************************")
                pare

            caso 15:
                escreva("\nA compaixão é a linguagem universal do coração.\n")
                escreva("******************************************************")
                pare

            caso 16:
                escreva("\nSorria, a felicidade é contagiante.\n")
                escreva("******************************************")
                pare

            caso 17:
                escreva("\nA cada desafio, surge uma oportunidade de crescimento.\n")
                escreva("***********************************************************")
                pare

            caso 18:
                escreva("\nO sucesso é a soma de pequenos esforços repetidos dia após dia.\n")
                escreva("********************************************************************")
                pare

            caso 19:
                escreva("\nA persistência é o caminho do êxito.\n")
                escreva("*******************************************")
                pare

            caso 20:
                escreva("\nA compaixão é a linguagem universal do coração.\n")
                escreva("*****************************************************")
                pare

            caso 21:
                escreva("\nSeja grato pelo que tem, e mais virá até você.\n")
                escreva("*****************************************************")
                pare

            caso 22:
                escreva("\nSuas escolhas moldam seu destino, escolha sabiamente.\n")
                escreva("**********************************************************")
                pare

            caso 23:
                escreva("\nCada novo dia é uma página em branco, escreva uma boa história.\n")
                escreva("********************************************************************")
                pare

            caso 24:
                escreva("\nO amor é a força mais poderosa do universo.\n")
                escreva("*************************************************")
                pare

            caso 25:
                escreva("\nA melhor maneira de prever o futuro é criá-lo.\n")
                escreva("*****************************************************")
                pare

            caso 26:
                escreva("\nSeja gentil com cada pessoa que você encontrar.\n")
                escreva("*****************************************************")
                pare

            caso 27:
                escreva("\nA verdadeira beleza está na simplicidade.\n")
                escreva("*************************************************")
                pare

            caso 28:
                escreva("\nO conhecimento é poder, compartilhe-o com o mundo.\n")
                escreva("*********************************************************")
                pare

            caso 29:
                escreva("\nA gratidão transforma o que temos em suficiente.\n")
                escreva("******************************************************")
                pare

            caso 30:
                escreva("\nA cada desafio, surge uma oportunidade de crescimento.\n")
                escreva("**********************************************************")
                pare

            caso 31:
                escreva("\nO sucesso é a soma de pequenos esforços repetidos dia após dia.\n")
                escreva("********************************************************************")
                pare
			
		}

		se(dia_aniversario > 31)
		escreva("\n***DIA INVALIDO***\n")
		senao se(dia_aniversario == 0)
		escreva("\n***DIA INVÁLIDO***\n")
	}
}
